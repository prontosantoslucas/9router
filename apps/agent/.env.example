# Identidade do Agente
AGENT_NAME=Lucas

# Telegram Bot API (opcional)
BOT_TOKEN=

# Telegram Userbot MTProto (opcional - para responder como conta pessoal)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# WhatsApp Evolution API (opcional)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=lucas

# Memória ai-memory (obrigatório)
AI_MEMORY_URL=http://127.0.0.1:8080
# Bearer token — só é necessário se o servidor ai-memory tiver AI_MEMORY_AUTH_TOKEN
# ativado (obrigatório em qualquer deploy exposto além de loopback, ex.: Render).
# Sem servidor local (loopback), pode deixar em branco.
AI_MEMORY_TOKEN=

# Personalidade via GitHub (opcional - URL de documento .md privado ou público)
GITHUB_PERSONALITY_URL=
GITHUB_TOKEN=

# 9router Gateway Interno
ROUTER_BASE_URL=http://127.0.0.1:20128/v1
ROUTER_API_KEY=

# Segredo de autenticação HMAC interno Proxy <-> Agent
AGENT_INTERNAL_SECRET=seu_segredo_hmac_aqui

# Porta interna do agente (loopback)
PORT=3717

# Interações autônomas
AUTONOMOUS_INTERACTIONS_ENABLED=true

# Model ranking
MODEL_RANKING=kr/auto-thinking,kr/claude-sonnet-4.5-thinking,kr/deepseek-3.2-thinking

# Cache de quota
QUOTA_RETRY_SEC=120

# Máximo de histórico
MAX_HISTORY=20

# Notion (opcional)
NOTION_TOKEN=
NOTION_DATABASE_ID=
# Banco dedicado da listagem de leads do prospector (propriedades tipadas:
# Nome, Telefone, Instagram, Site, Cidade, Nicho, Status, Origem, Data).
# Separado do NOTION_DATABASE_ID de propósito — misturar lead com nota
# polui os dois lados e a listagem deixa de ser filtrável.
# Pode ficar vazio: a tool notion_leads_setup cria o banco e persiste o id.
NOTION_LEADS_DATABASE_ID=

# LinkedIn MCP (opcional) — sidecar em sidecars/linkedin-mcp/
# LOCAL: subir com sidecars/linkedin-mcp/START.md e usar http://127.0.0.1:8765
# CLOUD (Railway): sidecars/linkedin-mcp/DEPLOY.md — usar https://<serviço>.up.railway.app
# Sem URL, as tools linkedin_* ficam desligadas mas o agent continua funcionando.
LINKEDIN_MCP_URL=
# Obrigatório quando o sidecar está exposto na internet. Deve bater com
# LINKEDIN_MCP_TOKEN configurado no container do sidecar.
LINKEDIN_MCP_TOKEN=

# Extensão Chrome MAXROUTER LinkedIn Helper (preferida)
# apps/extension/linkedin-helper/ — executa no browser real do usuário.
# Token compartilhado: agente exige em /api/extension/*, extensão envia em Authorization Bearer.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EXTENSION_TOKEN=

# Chave para cifrar o backup da sessão do WhatsApp (tabela wa_session_backup e
# o blob exportável). Se vazia, cai em AGENT_INTERNAL_SECRET, depois JWT_SECRET.
# IMPORTANTE: trocar esse valor torna backups antigos ilegíveis — o blob só
# abre com o mesmo segredo que o cifrou.
SESSION_BACKUP_KEY=

# ─────────────────────────────────────────────────────────────
# PUSH NO CELULAR (notificação dedicada, fora das conversas)
#
# Mensagem de Telegram já chega como push, mas cai no meio dos chats e o toque
# das 7h se perde ao lado do grupo da família. Com push dedicado o aviso chega
# como alerta, com título próprio.
#
# Quem usa: a tool `notify`, os toques do mentor e a fila proactive_notifications
# (só para o dono — outros destinatários continuam pelo canal do chat deles).
# Diagnóstico sem enviar nada: tool `notify_status`.
#
# OPÇÃO A — ntfy (gratuito, sem conta, Android e iOS). É o default.
#   1. Instale o app "ntfy" (Play Store / App Store).
#   2. Assine um tópico com nome LONGO E ALEATÓRIO.
#   3. Cole o mesmo nome aqui.
# ATENÇÃO: no ntfy.sh público, o nome do tópico É a senha — quem souber recebe
# e pode publicar. Nunca use algo adivinhável ("lucas", "avisos").
# Gere um com: node -e "console.log('maxrouter-'+require('crypto').randomBytes(9).toString('base64url'))"
NTFY_TOPIC=
# Servidor próprio (opcional). Vazio = https://ntfy.sh
NTFY_SERVER=
# Só necessário em tópico protegido ou servidor com autenticação.
NTFY_TOKEN=

# OPÇÃO B — Pushover (licença única paga, mais polido). Usado só se NTFY_TOPIC
# estiver vazio. As duas chaves são obrigatórias juntas.
PUSHOVER_TOKEN=
PUSHOVER_USER=

# Destino do fallback quando o push falha ou não está configurado: o chat do
# dono. É o nome que a tool `notify` procura primeiro; sem ele o código cai em
# SCANNER_NOTIFY_TELEGRAM_CHAT_ID, que significa outra coisa.
OWNER_CHAT_ID=
