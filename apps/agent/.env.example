# Identidade do Agente
AGENT_NAME=Lucas

# Telegram Bot API (opcional)
BOT_TOKEN=

# Telegram Userbot MTProto (opcional - para responder como conta pessoal)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# WhatsApp Evolution API (opcional)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=lucas

# Memória ai-memory (obrigatório)
AI_MEMORY_URL=http://127.0.0.1:8080
# Bearer token — só é necessário se o servidor ai-memory tiver AI_MEMORY_AUTH_TOKEN
# ativado (obrigatório em qualquer deploy exposto além de loopback, ex.: Render).
# Sem servidor local (loopback), pode deixar em branco.
AI_MEMORY_TOKEN=

# Personalidade via GitHub (opcional - URL de documento .md privado ou público)
GITHUB_PERSONALITY_URL=
GITHUB_TOKEN=

# 9router Gateway Interno
ROUTER_BASE_URL=http://127.0.0.1:20128/v1
ROUTER_API_KEY=

# Segredo de autenticação HMAC interno Proxy <-> Agent
AGENT_INTERNAL_SECRET=seu_segredo_hmac_aqui

# Porta interna do agente (loopback)
PORT=3717

# Interações autônomas
AUTONOMOUS_INTERACTIONS_ENABLED=true

# Model ranking
MODEL_RANKING=kr/auto-thinking,kr/claude-sonnet-4.5-thinking,kr/deepseek-3.2-thinking

# Cache de quota
QUOTA_RETRY_SEC=120

# Máximo de histórico
MAX_HISTORY=20

# Notion (opcional)
NOTION_TOKEN=
NOTION_DATABASE_ID=

# LinkedIn MCP (opcional) — sidecar em sidecars/linkedin-mcp/
# LOCAL: subir com sidecars/linkedin-mcp/START.md e usar http://127.0.0.1:8765
# CLOUD (Railway): sidecars/linkedin-mcp/DEPLOY.md — usar https://<serviço>.up.railway.app
# Sem URL, as tools linkedin_* ficam desligadas mas o agent continua funcionando.
LINKEDIN_MCP_URL=
# Obrigatório quando o sidecar está exposto na internet. Deve bater com
# LINKEDIN_MCP_TOKEN configurado no container do sidecar.
LINKEDIN_MCP_TOKEN=
