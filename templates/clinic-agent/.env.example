# =============================================
# CLINIC AGENT — env vars
# Copia esse arquivo pra .env e preenche os valores.
#
# NOTA: EVOLUTION_URL e EVOLUTION_TOKEN são COMPARTILHADOS com a
# aplicação 9router principal (você tem 1 Evolution API rodando pra
# tudo). Cada cliente muda só EVOLUTION_INSTANCE (nome único).
# Mesma coisa pra ROUTER_BASE_URL/API_KEY — todos apontam pro gateway
# 9router central em maxrouter.up.railway.app.
# =============================================

# --- Servidor ---
PORT=3000
NODE_ENV=production
DATA_DIR=./data
PUBLIC_URL=https://agente-clinicax.com.br

# --- Info da clínica (aparece no chat web + memória do agente) ---
CLINIC_NAME=Clínica Exemplo
CLINIC_TYPE=odontológica  # odontológica | estética | veterinária | dermatológica | ...
CLINIC_CITY=São Paulo
CLINIC_PHONE=+5511999999999
CLINIC_WHATSAPP=+5511999999999
CLINIC_INSTAGRAM=@clinicaexemplo
CLINIC_WEBSITE=https://clinicaexemplo.com.br
CLINIC_ADDRESS=Rua Exemplo, 123 — Bairro, São Paulo/SP

# --- Router LLM (COMPARTILHADO com 9router principal) ---
# Cria uma API key em /dashboard/endpoint do MaxRouter.
# Usa a mesma URL/gateway central pra todos os agentes.
ROUTER_BASE_URL=https://maxrouter.up.railway.app/v1
ROUTER_API_KEY=sk-9r-...
ROUTER_MODEL=gemini-2.5-flash  # ou auto, deepseek/deepseek-chat, etc.

# --- WhatsApp via Evolution API (COMPARTILHADA — mesma instância base do 9router) ---
# EVOLUTION_URL e EVOLUTION_TOKEN vêm do seu deploy central da Evolution
# API (que você já usa no 9router). Só EVOLUTION_INSTANCE muda por cliente.
EVOLUTION_URL=https://evo.your-central-server.com
EVOLUTION_TOKEN=your-shared-evolution-global-token
EVOLUTION_INSTANCE=clinicaexemplo   # nome único da instância dessa clínica
EVOLUTION_WEBHOOK_TOKEN=random-shared-secret-para-webhooks

# --- Google Calendar OAuth (por cliente — cada clínica tem seu Calendar) ---
# https://console.cloud.google.com/apis/credentials
# Você pode reusar o mesmo Client ID do 9router se quiser (aceita múltiplos redirect URIs).
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxx
GOOGLE_REDIRECT_URI=https://agente-clinicax.com.br/oauth/google/callback
GOOGLE_CALENDAR_ID=primary   # ou id do calendar específico da clínica

# --- CRM (opcional — v2) ---
# Habilita sync automático de leads/pacientes pro CRM da clínica.
# Deixa vazio pra desativar.
CRM_PROVIDER=            # rdstation | hubspot | (vazio = off)

# RD Station Marketing:
RDSTATION_API_TOKEN=     # https://app.rdstation.com.br → Integrações → RD Station Marketing → Tokens
RDSTATION_IDENTIFIER=maxrouter-clinic-agent

# HubSpot Free (Private App token — precisa scopes crm.objects.contacts.write / .read):
HUBSPOT_PRIVATE_APP_TOKEN=

# --- Follow-up e Reengajamento (v3/v4 — workers) ---
WORKERS_ENABLED=true           # false pra desabilitar em ambientes de dev
REMINDER_HOURS_BEFORE=24       # v3: lembrete X horas antes da consulta (transacional, envia sempre)
REENGAGE_TIERS=15,30,60        # v4: dias de silêncio pra reativar paciente inativo.
                               # Cada tier manda 1 msg escalando o apelo (15d leve → 60d+ oferta).
                               # Só dispara em AGENT_MODE=prod (LGPD). Em test, só registra.

# --- Agente ---
AGENT_MODE=test   # test = revisão humana antes de enviar; prod = envia direto
AGENT_NAME=Isabela   # nome que aparece pro paciente
AGENT_OWNER_NAME=Dr. Fulano   # dono da clínica (uso interno)
AGENT_OWNER_WHATSAPP=+5511988888888   # pra escalar

# --- Segurança do chat web ---
DASHBOARD_PASSWORD=troca-isso-por-senha-forte
WEBHOOK_SECRET=random-string-hmac-webhook-verify
