# =============================================
# CLINIC AGENT — env vars
# Copia esse arquivo pra .env e preenche os valores
# =============================================

# --- Servidor ---
PORT=3000
NODE_ENV=production
DATA_DIR=./data
PUBLIC_URL=https://agente-clinicax.com.br

# --- Info da clínica (aparece no chat web + memória do agente) ---
CLINIC_NAME=Clínica Exemplo
CLINIC_TYPE=odontológica  # odontológica | estética | veterinária | dermatológica | ...
CLINIC_CITY=São Paulo
CLINIC_PHONE=+5511999999999
CLINIC_WHATSAPP=+5511999999999
CLINIC_INSTAGRAM=@clinicaexemplo
CLINIC_WEBSITE=https://clinicaexemplo.com.br
CLINIC_ADDRESS=Rua Exemplo, 123 — Bairro, São Paulo/SP

# --- Router LLM (MaxRouter 9router) ---
# Cria uma API key em /dashboard/endpoint do MaxRouter
ROUTER_BASE_URL=https://maxrouter.up.railway.app/v1
ROUTER_API_KEY=sk-9r-...
ROUTER_MODEL=gemini-2.5-flash  # ou auto, deepseek/deepseek-chat, etc.

# --- WhatsApp via Evolution API ---
EVOLUTION_URL=https://evo.your-server.com
EVOLUTION_TOKEN=your-evolution-global-token
EVOLUTION_INSTANCE=clinicaexemplo   # nome único da instância
EVOLUTION_WEBHOOK_TOKEN=random-shared-secret-para-webhooks

# --- Google Calendar OAuth ---
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxx
GOOGLE_REDIRECT_URI=https://agente-clinicax.com.br/oauth/google/callback
GOOGLE_CALENDAR_ID=primary   # ou id do calendar específico da clínica

# --- Agente ---
AGENT_MODE=test   # test = revisão humana antes de enviar; prod = envia direto
AGENT_NAME=Isabela   # nome que aparece pro paciente
AGENT_OWNER_NAME=Dr. Fulano   # dono da clínica (uso interno)
AGENT_OWNER_WHATSAPP=+5511988888888   # pra escalar

# --- Segurança do chat web ---
DASHBOARD_PASSWORD=troca-isso-por-senha-forte
WEBHOOK_SECRET=random-string-hmac-webhook-verify
